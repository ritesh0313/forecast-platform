# Run node scripts/setup-env.mjs to generate .env with unique local secrets.
# These placeholders deliberately cannot start the stack.
POSTGRES_PASSWORD=
JWT_SECRET=
MODEL_SERVICE_TOKEN=
PORT=3000
# Test or local-host development only; Compose sets internal DATABASE_URL automatically.
# DATABASE_URL=postgresql://forecast:YOUR_PASSWORD@127.0.0.1:5432/forecast
# MODEL_SERVICE_URL=http://127.0.0.1:8000
